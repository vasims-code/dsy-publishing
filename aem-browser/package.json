{
  "name": "dsy",
  "productName": "DSY",
  "version": "0.3.6",
  "description": "DSY — Digital Samsung Yard: a browser for Samsung.com publishing, with the AEM Toolkit built in.",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build-engine.mjs && vite build",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "icon": "electron scripts/icon-from-image.mjs build/icon-source.jpg",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-switch": "^1.1.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.21.5",
    "lucide-react": "^0.460.0",
    "next-themes": "^0.4.3",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.4.11"
  },
  "author": "Samsung Publishing",
  "build": {
    "appId": "com.aemtoolkit.browser",
    "productName": "DSY",
    "copyright": "Samsung Publishing",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "44.7.0",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSY",
      "artifactName": "DSY-Setup-${version}.exe"
    }
  }
}
