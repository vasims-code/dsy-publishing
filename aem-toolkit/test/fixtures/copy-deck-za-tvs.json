        "sling:resourceType": "samsung/components/content/consumer/global/common/cm-g-static-content",
        "bodyHtml": "<!-- 2026 VD TVs PCD -->\r\n    <style>\r\n        @media screen and (max-width:767px) {\r\n            .shop-tv-size .viewing-distance .tv-size-range .unit:before{content:\"or more\";display:inline-block;}\r\n            .shop-tv-size .title:after{content:\"\";display:block;}\r\n        }\r\n    </style>\r\n    <div class=\"shop-tv-size\">\r\n        <div class=\"title\">\r\n            <h3>Find the right TV size for your space</h3>\r\n            <p>These recommendations are designed for an immersive viewing experience.</p>\r\n        </div>\r\n        <div class=\"viewing-distance\">\r\n            <h3>Viewing Distance (meters)</h3>\r\n            <div class=\"ui\"><input type=\"range\" title=\"Select viewing distance\" min=\"1\" max=\"7\" value=\"5\" step=\"0.01\" autocomplete=\"off\"></div>\r\n            <div class=\"unit\"><span>1.1m</span><span>2.5m</span></div>\r\n        </div>\r\n        <div class=\"viewing\">\r\n            <div class=\"view-box\"><p>We Recommend</p><div class=\"size\">75\" TVs</div></div>\r\n            <a href=\"https://www.samsung.com/za/tvs/75-inch-tvs/\" class=\"shop-link\">View all 75'' TVs</a>\r\n            <a href=\"https://www.samsung.com/za/tvs/tv-buying-guide/what-size-tv-should-i-get/\" aria-label=\"Learn more: TV Buying Guide What size TV should i get?\" class=\"size-link\">Learn more</a>\r\n        </div>\r\n    </div>\r\n    <script>\r\n        const tvsize_range = {\r\n            init: function(){\r\n                const value= ['43\" TVs','98\" TVs or larger'];\r\n                const btnValue= [\"View all 43'' TVs\",\"View all 98'' TVs or larger\"];\r\n                const links = [\"https://www.samsung.com/africa_en/tvs/43-inch-tvs/\"];\r\n                const input = document.querySelector('.tv-size-range input')\r\n                input.addEventListener(\"input\", (event) => {});\r\n            }\r\n        }\r\n        tvsize_range.init();\r\n    </script>\r\n    <!-- 2026 VD TVs PCD -->",
        "jcr:primaryType": "nt:unstructured"
      },
